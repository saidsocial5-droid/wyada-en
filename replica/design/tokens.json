    "note": "Pressable 3D look: a solid bottom edge in the *-edge colour; pressed = edge 0 and translateY(edge).",
    "edge-sm": 3,
    "edge-md": 4,
    "edge-lg": 5
  },
  "shadow": {
    "sm": {
      "y": 1,
      "blur": 2,
      "opacity": 0.08
    },
    "md": {
      "y": 4,
      "blur": 12,
      "opacity": 0.12
    }
  },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 360,
