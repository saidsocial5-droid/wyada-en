    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "scale": {
      "xs": {
        "size": 12,
        "line": 16
      },
      "sm": {
        "size": 14,
        "line": 20
      },
      "md": {
        "size": 16,
        "line": 24
      },
      "lg": {
        "size": 18,
        "line": 26
      },
      "xl": {
        "size": 22,
        "line": 30
      },
      "2xl": {
        "size": 28,
        "line": 36
      },
      "3xl": {
        "size": 36,
        "line": 44
      }
    },
    "arabic_line_multiplier": 1.15,
    "min_body": 16,
    "note": "Exercise prompts use lg/xl. Answers typed by the learner are always LTR English."
